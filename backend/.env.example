# Copy this file to ".env" in the same folder and fill in the values.
# ".env" holds secrets: it is ignored by git and must not be shared.
# On Linux, make it readable only by the account that runs the backend:
#     chmod 600 .env

# Control server
ROBOTWEB_CONTROL_HOST=127.0.0.1
ROBOTWEB_CONTROL_PORT=13000

# BL22 REST API
ROBOTWEB_BL22_API_URL=
ROBOTWEB_BL22_API_KEY=

# E-mails to the operators when a run stops, waits for beam or goes on again.
# Addresses comma separated. Without ROBOTWEB_SMTP_HOST the control server
# sends them. Security: starttls (port 587), ssl (port 465) or none (port 25).
# Try the settings with:  python -m robotweb.notify
ROBOTWEB_OPERATOR_EMAILS=
ROBOTWEB_SMTP_HOST=
ROBOTWEB_SMTP_PORT=587
ROBOTWEB_SMTP_SECURITY=starttls
ROBOTWEB_SMTP_USER=
ROBOTWEB_SMTP_PASSWORD=
ROBOTWEB_SMTP_FROM=

# IP camera shown at the top of the page (AXIS, MJPEG over HTTP).
# Host: the address of the camera, with ":port" if that is not 80, and with
# "https://" in front if the camera only answers there. Leave it empty if
# there is no camera. User and password: an account of the camera. A
# "viewer" account is enough for the picture; to turn and zoom the camera
# from the page it has to be an "operator" account of the camera. The backend
# keeps them to itself: browsers get the picture from the backend and never
# see them.
# Latency comes before picture quality: a lower resolution, or a higher
# compression (0 to 100), makes the pictures smaller and faster.
ROBOTWEB_CAMERA_HOST=
ROBOTWEB_CAMERA_USER=
ROBOTWEB_CAMERA_PASSWORD=
ROBOTWEB_CAMERA_RESOLUTION=1280x720
ROBOTWEB_CAMERA_FPS=15
ROBOTWEB_CAMERA_COMPRESSION=30

# HTTPS: set to true when the backend is started with a certificate (see
# "HTTPS" in README.md). The browser then never sends the login cookie over
# an unencrypted connection, and logging in over plain HTTP does not work.
ROBOTWEB_COOKIE_SECURE=false

# Commands that move hardware (false until deliberately switched on)
ROBOTWEB_MOTION_COMMANDS_ENABLED=false
