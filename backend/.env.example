# Copy this file to ".env" in the same folder and fill in the values.
# ".env" holds secrets: it is ignored by git and must not be shared.
# On Linux, make it readable only by the account that runs the backend:
#     chmod 600 .env

# Control server
ROBOTWEB_CONTROL_HOST=127.0.0.1
ROBOTWEB_CONTROL_PORT=13000

# BL22 REST API
ROBOTWEB_BL22_API_URL=
ROBOTWEB_BL22_API_KEY=

# E-mails to the operators when a run stops, waits for beam or goes on again.
# Addresses comma separated. Without ROBOTWEB_SMTP_HOST the control server
# sends them. Security: starttls (port 587), ssl (port 465) or none (port 25).
# Try the settings with:  python -m robotweb.notify
ROBOTWEB_OPERATOR_EMAILS=
ROBOTWEB_SMTP_HOST=
ROBOTWEB_SMTP_PORT=587
ROBOTWEB_SMTP_SECURITY=starttls
ROBOTWEB_SMTP_USER=
ROBOTWEB_SMTP_PASSWORD=
ROBOTWEB_SMTP_FROM=

# Commands that move hardware (false until deliberately switched on)
ROBOTWEB_MOTION_COMMANDS_ENABLED=false
